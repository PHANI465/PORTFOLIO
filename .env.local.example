# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — OpenAI (for AI assistant)
# Get your key at: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Pinecone (for AI assistant RAG / vector search)
# Free tier at: https://pinecone.io — create an index named "portfolio"
# ─────────────────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_your_pinecone_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=portfolio

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Resend (for contact form email delivery)
# Free tier at: https://resend.com — 3,000 emails/month free
# Without this, messages still save to data/contacts.json
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
CONTACT_TO_EMAIL=your@email.com

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Admin dashboard password
# ─────────────────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=changeme123

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC — Portfolio configuration (safe to commit)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PORTFOLIO_NAME=Your Name
NEXT_PUBLIC_PORTFOLIO_EMAIL=your@email.com
NEXT_PUBLIC_DEFAULT_THEME=cyberpunk-ai
# Available themes: cyberpunk-ai | terminal-hacker | glassmorphism |
#                   minimal-professional | dark-professional | bright-neon |
#                   futuristic-space | anime-gaming | retro-pixel
