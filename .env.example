# ============================================================
# AI PORTFOLIO PLATFORM - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ---- OPENAI CONFIGURATION ----
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# ---- PINECONE CONFIGURATION (for AI RAG) ----
# Get your key at: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=portfolio

# ---- DASHBOARD AUTHENTICATION ----
# Choose any secure password for your admin dashboard
DASHBOARD_PASSWORD=your-secure-password-here

# ---- PORTFOLIO CONFIGURATION ----
NEXT_PUBLIC_PORTFOLIO_NAME=Phaneendra Gavara
NEXT_PUBLIC_PORTFOLIO_EMAIL=phaneendragavara436@gmail.com
NEXT_PUBLIC_PORTFOLIO_URL=https://your-domain.vercel.app
NEXT_PUBLIC_DEFAULT_THEME=cyberpunk-ai

# ---- CONTACT FORM EMAIL (using nodemailer) ----
# For Gmail: use an App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=phaneendragavara436@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=phaneendragavara436@gmail.com

# ---- ANALYTICS (Optional) ----
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

