# ============================================================
# AI PORTFOLIO PLATFORM - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ---- OPENAI CONFIGURATION ----
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# ---- PINECONE CONFIGURATION (for AI RAG) ----
# Get your key at: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=portfolio

# ---- DASHBOARD AUTHENTICATION ----
# Choose any secure password for your admin dashboard
DASHBOARD_PASSWORD=your-secure-password-here

# ---- PORTFOLIO CONFIGURATION ----
NEXT_PUBLIC_PORTFOLIO_NAME=Phaneendra Gavara
NEXT_PUBLIC_PORTFOLIO_EMAIL=phaneendra.gavara@gmail.com
NEXT_PUBLIC_PORTFOLIO_URL=https://your-domain.vercel.app
NEXT_PUBLIC_DEFAULT_THEME=cyberpunk-ai

# ---- CONTACT FORM EMAIL (using nodemailer) ----
# For Gmail: use an App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=phaneendra.gavara@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=phaneendra.gavara@gmail.com

# ---- ANALYTICS (Optional) ----
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---- VERCEL (auto-set by Vercel, do not edit) ----
# VERCEL_ENV=production

# ---- 100 Day Challenge ----
# Supabase project (Settings -> API). The anon key is public by design;
# Row Level Security limits it to reading published rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin credentials. Generate with: npm run challenge:hash -- "your-password"
CHALLENGE_ADMIN_USER=
CHALLENGE_ADMIN_PASSWORD_HASH=
CHALLENGE_SESSION_SECRET=
