'use client'

import { motion } from 'framer-motion'
import { useState, useEffect } from 'react'
import Link from 'next/link'
import { Portfolio } from '@/types'

const bootSequence = [
  'Initializing portfolio kernel v2.0...',
  'Loading user profile: phaneendra_gavara',
  'Mounting data science modules... [OK]',
  'Loading ML pipeline... [OK]',
  'Connecting to OpenAI API... [OK]',
  'RAG system ready... [OK]',
  'Portfolio online. Welcome.',
]

interface HeroProps { portfolio: Portfolio }

export default function TerminalHero({ portfolio }: HeroProps) {
  const [bootLines, setBootLines] = useState<string[]>([])
  const [showMain, setShowMain] = useState(false)
  const [typedBio, setTypedBio] = useState('')
  const [cursor, setCursor] = useState(true)

  useEffect(() => {
    let lineIdx = 0
    const addLine = () => {
      if (lineIdx < bootSequence.length) {
        setBootLines(prev => [...prev, bootSequence[lineIdx]])
        lineIdx++
        setTimeout(addLine, 200 + Math.random() * 200)
      } else {
        setTimeout(() => setShowMain(true), 400)
      }
    }
    setTimeout(addLine, 300)
    const cursorInterval = setInterval(() => setCursor(c => !c), 530)
    return () => clearInterval(cursorInterval)
  }, [])

  useEffect(() => {
    if (!showMain) return
    const bio = portfolio.bio
    let i = 0
    const type = () => {
      if (i < bio.length) {
        setTypedBio(bio.slice(0, i + 1))
        i++
        setTimeout(type, 18)
      }
    }
    setTimeout(type, 300)
  }, [showMain, portfolio.bio])

  return (
    <section className="min-h-screen flex items-center pt-20 pb-10 px-4" style={{ background: '#0d0d0d' }}>
      <div className="max-w-4xl mx-auto w-full">
        {/* Boot sequence */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          className="mb-6 space-y-0.5"
          style={{ fontFamily: 'Share Tech Mono, monospace' }}
        >
          {bootLines.map((line, i) => (
            <motion.div
              key={i}
              initial={{ opacity: 0, x: -10 }}
              animate={{ opacity: 1, x: 0 }}
              className="text-xs text-[#00ff41]/50"
            >
              <span className="text-[#00ff41]/30">[ {String(i).padStart(2, '0')} ]</span>
              <span className="ml-2">{line}</span>
            </motion.div>
          ))}
        </motion.div>

        {showMain && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.5 }}>
            {/* Separator */}
            <div className="border-t border-[#00ff41]/20 mb-6" />

            {/* Prompt */}
            <div className="mb-2" style={{ fontFamily: 'Share Tech Mono, monospace' }}>
              <span className="text-[#00ff41]/50 text-xs">phaneendra@portfolio:~$</span>
              <span className="text-[#00ff41] text-xs ml-2">whoami</span>
            </div>

            {/* Name */}
            <h1
              className="text-3xl md:text-5xl font-bold text-[#00ff41] mb-2"
              style={{
                fontFamily: 'Share Tech Mono, monospace',
                textShadow: '0 0 20px rgba(0,255,65,0.4)',
              }}
            >
              Phaneendra Gavara
            </h1>

            <div className="flex items-center gap-2 mb-6" style={{ fontFamily: 'Share Tech Mono, monospace' }}>
              <span className="text-[#ffb000] text-sm">&gt;&gt;</span>
              <span className="text-[#00ff41]/70 text-sm">{portfolio.title}</span>
            </div>

            {/* Bio output */}
            <div className="mb-2" style={{ fontFamily: 'Share Tech Mono, monospace' }}>
              <span className="text-[#00ff41]/50 text-xs">phaneendra@portfolio:~$</span>
              <span className="text-[#00ff41] text-xs ml-2">cat bio.txt</span>
            </div>

            <div
              className="text-[#00ff41]/70 text-sm leading-relaxed mb-8 max-w-2xl border-l-2 border-[#00ff41]/20 pl-4"
              style={{ fontFamily: 'Share Tech Mono, monospace' }}
            >
              {typedBio}
              {cursor && <span className="text-[#00ff41]">█</span>}
            </div>

            {/* Commands */}
            <div className="space-y-2" style={{ fontFamily: 'Share Tech Mono, monospace' }}>
              <div>
                <span className="text-[#00ff41]/50 text-xs">phaneendra@portfolio:~$</span>
                <span className="text-[#00ff41] text-xs ml-2">ls commands/</span>
              </div>
              <div className="flex flex-wrap gap-3 pl-4">
                {[
                  { label: './view-projects', href: '/projects' },
                  { label: './my-experience', href: '/experience' },
                  { label: './download-resume', href: portfolio.resumeUrl, download: true },
                  { label: './contact-me', href: '/contact' },
                ].map(({ label, href, download }) => (
                  <Link
                    key={href}
                    href={href}
                    download={download}
                    className="text-sm text-[#ffb000] hover:text-[#00ff41] underline transition-colors"
                  >
                    {label}
                  </Link>
                ))}
              </div>
            </div>
          </motion.div>
        )}
      </div>
    </section>
  )
}
